{
    "name": "latchvector/sso",
    "description": "Official PHP SDK for Latch Vector SSO — token verification and authentication.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "LatchVector",
            "email": "support@latchvector.com",
            "homepage": "https://latchvector.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.1",
        "guzzlehttp/guzzle": "^7.8",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.13|^3.0",
        "doctrine/orm": "^3.0",
        "illuminate/config": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0",
        "phpunit/phpunit": "^10.5",
        "symfony/cache": "^7.2|^8.0",
        "symfony/config": "^7.2|^8.0",
        "symfony/dependency-injection": "^7.2|^8.0",
        "symfony/framework-bundle": "^7.2|^8.0",
        "symfony/http-foundation": "^7.2|^8.0",
        "symfony/http-kernel": "^7.2|^8.0",
        "symfony/security-http": "^7.2|^8.0",
        "symfony/yaml": "^7.2|^8.0"
    },
    "suggest": {
        "laravel/framework": "For the Laravel middleware, service provider and BelongsToTenant model scope",
        "symfony/security-bundle": "For the Symfony authenticator",
        "doctrine/orm": "For the Doctrine tenant boundary (TenantFilter + BelongsToTenant traits)",
        "symfony/framework-bundle": "To auto-wire the tenant boundary via LatchVectorSsoBundle"
    },
    "autoload": {
        "psr-4": {
            "LatchVector\\Sso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LatchVector\\Sso\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LatchVector\\Sso\\Laravel\\SsoServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}

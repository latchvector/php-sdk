{
    "name": "latchvector/sso",
    "description": "Official PHP SDK for Latch Vector SSO — token verification and authentication.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.1",
        "guzzlehttp/guzzle": "^7.8",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "laravel/framework": "For the Laravel middleware and service provider",
        "symfony/security-bundle": "For the Symfony authenticator"
    },
    "autoload": {
        "psr-4": {
            "LatchVector\\Sso\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LatchVector\\Sso\\Laravel\\SsoServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
